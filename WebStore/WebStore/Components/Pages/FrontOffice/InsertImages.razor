@page "/image-upload"
@inject IJSRuntime JS
@inject ImageService ImageService
@rendermode InteractiveServer

<h3>Upload Image</h3>

<EditForm Model="@uploadModel" OnValidSubmit="UploadImage" FormName="uploadForm1">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Choose Image File:</label>
        <InputFile OnChange="HandleFileSelected" FormName="uploadForm1" />
    </div>

    <div class="mb-3">
        <label>Optional Image Name:</label>
        <InputText @bind-Value="uploadModel.Name" class="form-control" />
    </div>

    <RadzenButton Text="Upload" Type="Submit" Style="margin-top: 10px;" />
</EditForm>

@code {
	private UploadImageModel uploadModel = new();
	private IBrowserFile? selectedFile;
	private string uploadResult = string.Empty;

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		selectedFile = e.File;

		uploadResult = selectedFile != null ? $"Selected file: {selectedFile.Name}" : "No file selected";

	}

	private async Task UploadImage()
	{
		if (selectedFile == null)
		{
			uploadResult = "Please select a file first.";
			return;
		}

		using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10_000_000); // 10MB limit

		var uploadedPath = await ImageService.UploadImageAsync(
			category: ImageCategory.Campaign, // Adjust as needed (Product, Campaign, Review, etc.)
			ownerId: 1,                           // Example ownerId (e.g., ProductId)
			fileStream: stream,
			originalFileName: selectedFile.Name,
			name: uploadModel.Name
		);

		await JS.InvokeVoidAsync("alert", uploadedPath);
		if (uploadedPath != null)
		{
			uploadResult = $"Uploaded successfully! Path: {uploadedPath}";
		}
		else
		{
			uploadResult = "Upload failed.";
		}
	}

	private class UploadImageModel
	{
		public string? Name { get; set; }
	}
}
